# Salin file ini menjadi .env.local untuk pengembangan lokal,
# dan masukkan juga ke Environment Variables di dashboard Netlify.

# 1. Database & Storage Supabase (Tahap 1)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# Rahasia server: JANGAN pernah diberi awalan NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Whitelist Email Admin /admin (pisahkan dengan koma jika lebih dari satu)
ADMIN_EMAILS=admin@email-kamu.com

# 3. Payment Gateway Midtrans Snap (Tahap 3 - gunakan kunci Sandbox terlebih dahulu)
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-your-client-key
MIDTRANS_SERVER_KEY=SB-Mid-server-your-server-key
